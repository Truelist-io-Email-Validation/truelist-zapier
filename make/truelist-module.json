{
  "name": "truelist",
  "label": "Truelist",
  "description": "Email validation powered by Truelist",
  "version": "0.2.0",
  "baseUrl": "https://api.truelist.io",
  "connections": [
    {
      "name": "truelist-api-key",
      "label": "Truelist API Key",
      "type": "apikey",
      "parameters": [
        {
          "name": "apiKey",
          "label": "API Key",
          "type": "text",
          "required": true,
          "help": "Your Truelist API key from https://truelist.io/dashboard"
        }
      ],
      "common": {
        "headers": {
          "Authorization": "Bearer {{parameters.apiKey}}",
          "Accept": "application/json"
        }
      },
      "test": {
        "url": "/me",
        "method": "GET"
      }
    }
  ],
  "modules": [
    {
      "name": "validateEmail",
      "label": "Validate Email",
      "description": "Validate an email address for deliverability",
      "type": "action",
      "connection": "truelist-api-key",
      "parameters": [
        {
          "name": "email",
          "label": "Email Address",
          "type": "text",
          "required": true,
          "help": "The email address to validate"
        }
      ],
      "request": {
        "url": "/api/v1/verify_inline?email={{parameters.email}}",
        "method": "POST"
      },
      "response": {
        "output": [
          { "name": "state", "label": "State", "type": "text" },
          { "name": "sub_state", "label": "Sub-State", "type": "text" },
          { "name": "domain", "label": "Domain", "type": "text" },
          { "name": "suggestion", "label": "Suggestion", "type": "text" }
        ]
      }
    },
    {
      "name": "getAccount",
      "label": "Get Account Info",
      "description": "Retrieve account details including plan and admin status",
      "type": "action",
      "connection": "truelist-api-key",
      "parameters": [],
      "request": {
        "url": "/me",
        "method": "GET"
      },
      "response": {
        "output": [
          { "name": "email", "label": "Email", "type": "text" },
          { "name": "name", "label": "Name", "type": "text" },
          { "name": "uuid", "label": "UUID", "type": "text" }
        ]
      }
    }
  ]
}
